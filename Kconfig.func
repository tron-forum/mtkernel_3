# Kconfig.func — µT-Kernel feature groups and syscall stubs
#
# Corresponds to: mtkernel_3/config/config_func.h
#
# Section 1: Feature group flags (USE_SEMAPHORE etc.)
#   Control which IPC/OS object types are compiled into the kernel.
#
# Section 2: Syscall stubs (USE_FUNC_TK_* / USE_FUNC_TD_*)
#   Control whether each individual syscall body is compiled.
#   These are "presence defines": the kernel source uses #ifdef, not #if.
#   kconfig_gen.py emits:
#     enabled  → #define USE_FUNC_TK_DEL_TSK (1)
#     disabled → /* USE_FUNC_TK_DEL_TSK is not set */
#   All symbols default to y (= same behaviour as original config_func.h).
#   The depends-on clauses ensure that disabling a feature group also
#   disables the stubs that belong to it.

# ---------------------------------------------------------------------------
# Feature groups
# ---------------------------------------------------------------------------

config USE_SEMAPHORE
	bool "Include semaphore support"
	default y

config USE_MUTEX
	bool "Include mutex support"
	default y

config USE_EVENTFLAG
	bool "Include event flag support"
	default y

config USE_MAILBOX
	bool "Include mailbox support"
	default y

config USE_MESSAGEBUFFER
	bool "Include message buffer support"
	default y

config USE_RENDEZVOUS
	bool "Include rendezvous (legacy API) support"
	default y
	depends on USE_LEGACY_API

config USE_MEMORYPOOL
	bool "Include variable-size memory pool support"
	default y

config USE_FIX_MEMORYPOOL
	bool "Include fixed-size memory pool support"
	default y

config USE_TIMEMANAGEMENT
	bool "Include time management API"
	default y

config USE_CYCLICHANDLER
	bool "Include cyclic handler support"
	default y

config USE_ALARMHANDLER
	bool "Include alarm handler support"
	default y

config USE_DEVICE
	bool "Include device management support"
	default y

config USE_FAST_LOCK
	bool "Include fast lock (spin-lock) support"
	default y

config USE_MULTI_LOCK
	bool "Include multi-lock support"
	default y

# ---------------------------------------------------------------------------
# Syscall stubs (linker dead-stripping)
# ---------------------------------------------------------------------------

menu "Syscall stubs (linker dead-stripping)"

