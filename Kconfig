config USE_DBGSPT
	bool "Use mT-Kernel/DS debug support"
	default y

config USE_OBJECT_NAME
	bool "Use DS object name"
	default n

config OBJECT_NAME_LENGTH
	int "DS object name length (characters)"
	default 8

