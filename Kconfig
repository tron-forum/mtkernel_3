	int
	default 0

config CNF_VER_PRNO2
	int
	default 0

config CNF_VER_PRNO3
	int
	default 0

config CNF_VER_PRNO4
	int
	default 0

# ---------------------------------------------------------------------------
# Stack sizes
# ---------------------------------------------------------------------------

config CNF_EXC_STACK_SIZE
	int "Exception stack size in bytes (0 = BSP default)"
	default 2048

config CNF_TMP_STACK_SIZE
	int "Temporary stack size in bytes"
	default 256

# ---------------------------------------------------------------------------
# System function selection
# ---------------------------------------------------------------------------

config USE_NOINIT
	bool "Use zero-clear BSS section"
	default n

config USE_IMALLOC
	bool "Use dynamic memory allocation (imalloc)"
	default y

config USE_SHUTDOWN
	bool "Use system shutdown function"
	default y

config USE_STATIC_IVT
	bool "Use static interrupt vector table"
	default n

# ---------------------------------------------------------------------------
# API parameter checks
# ---------------------------------------------------------------------------

config CHK_NOSPT
	bool "Check unsupported function (E_NOSPT)"
	default y

config CHK_RSATR
	bool "Check reservation attribute error (E_RSATR)"
	default y

config CHK_PAR
	bool "Check parameter error (E_PAR)"
	default y

config CHK_ID
	bool "Check object ID range (E_ID)"
	default y

config CHK_OACV
	bool "Check object access violation (E_OACV)"
	default y

config CHK_CTX
	bool "Check task-independent context (E_CTX)"
	default y

config CHK_CTX1
	bool "Check dispatch-disable context"
	default y

config CHK_CTX2
	bool "Check task-independent part context"
	default y

config CHK_SELF
	bool "Check self-task specification (E_OBJ)"
	default y

config CHK_TKERNEL_CONST
	bool "Check const-type parameter"
	default y

