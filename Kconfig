# µT-Kernel 3.0 — core configuration
#
# Corresponds to: mtkernel_3/config/config.h
# Defaults match the original upstream config.h (non-BSP2 values).

# ---------------------------------------------------------------------------
# SYSCONF — system memory area
# ---------------------------------------------------------------------------

config CNF_SYSTEMAREA_TOP
	int "System memory area top address (0 = use system default)"
	default 0

config CNF_SYSTEMAREA_END
	int "System memory area end address (0 = use system default)"
	default 0

# ---------------------------------------------------------------------------
# SYSCONF — scheduling
# ---------------------------------------------------------------------------

config CNF_MAX_TSKPRI
	int "Maximum task priority level"
	default 32
	range 16 256

config CNF_TIMER_PERIOD
	int "System timer period (ms)"
	default 10
	range 1 100

# ---------------------------------------------------------------------------
# Kernel object limits
# ---------------------------------------------------------------------------

config CNF_MAX_TSKID
	int "Maximum task objects"
	default 32

config CNF_MAX_SEMID
	int "Maximum semaphore objects"
	default 16

config CNF_MAX_FLGID
	int "Maximum event flag objects"
	default 16

config CNF_MAX_MBXID
	int "Maximum mailbox objects"
	default 8

config CNF_MAX_MTXID
	int "Maximum mutex objects"
	default 4

config CNF_MAX_MBFID
	int "Maximum message buffer objects"
	default 8

config CNF_MAX_MPLID
	int "Maximum memory pool objects"
	default 4

config CNF_MAX_MPFID
	int "Maximum fixed-size memory pool objects"
	default 8

config CNF_MAX_CYCID
	int "Maximum cyclic handler objects"
	default 4

config CNF_MAX_ALMID
	int "Maximum alarm handler objects"
	default 8

# ---------------------------------------------------------------------------
# Device management limits
# ---------------------------------------------------------------------------

config CNF_MAX_REGDEV
	int "Maximum registered devices"
	default 8

config CNF_MAX_OPNDEV
	int "Maximum simultaneously open devices"
	default 16

config CNF_MAX_REQDEV
	int "Maximum device requests"
	default 16

config CNF_DEVT_MBFSZ0
	int "Device event notification message buffer size (-1 = default)"
	default -1

config CNF_DEVT_MBFSZ1
	int "Device event notification message max size (-1 = default)"
	default -1

